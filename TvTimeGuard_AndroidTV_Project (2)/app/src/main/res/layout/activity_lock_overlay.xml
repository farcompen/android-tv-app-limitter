<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F50F0F12"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/txtLockMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="⏳ SÜRE DOLDU!"
        android:textColor="#EF4444"
        android:textSize="26sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtPinCode"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/cyan_accent"
        android:gravity="center"
        android:hint="Ebeveyn PIN"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/emerald_accent"
            android:text="Kilidi Aç (+30 Dk)"
            android:textColor="@color/bg_dark" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/card_dark"
            android:text="TV Ana Menüsüne Dön"
            android:textColor="@color/text_white" />
    </LinearLayout>

</LinearLayout>
